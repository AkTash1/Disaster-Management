# -----------------------------------------------------------------
# .env  —  Copy this file to .env and fill in your credentials
# DO NOT commit .env to git (it is in .gitignore)
# -----------------------------------------------------------------

# -- MOSDAC (mosdac.gov.in) ---------------------------------------
MOSDAC_USERNAME=your_email@example.com
MOSDAC_PASSWORD=your_mosdac_password

# -- Bhuvan/NRSC (bhuvan-app1.nrsc.gov.in) -----------------------
# Log in at https://bhuvan-app1.nrsc.gov.in/api/
# Your daily token is shown on the homepage after login (valid 24h)
# Only needed for --action api (LULC thematic statistics)
BHUVAN_API_TOKEN=

# -- IMD API (api.imd.gov.in) — OPTIONAL -------------------------
# Only needed for real-time forecasts.
# Historical rainfall via imdlib needs NO key.
IMD_API_KEY=
